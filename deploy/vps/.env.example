# Twenty — deploy en VPS. Copiar a `.env` y completar.
# El `.env` real NUNCA se commitea (está en .gitignore como **/**/.env).

# El compose pinea la imagen `twenty-fork:latest` construida en el server,
# así que esta variable hoy no la usa nadie. Se deja por compatibilidad.
TAG=latest

# --- Postgres (contenedor twenty_db) ---
PG_DATABASE_USER=twenty
# generar: openssl rand -base64 24
PG_DATABASE_PASSWORD=
PG_DATABASE_NAME=default

# --- App ---
# Dominio raíz. Con IS_MULTIWORKSPACE_ENABLED cada workspace vive en un
# subdominio (<slug>.<dominio>), por eso el router de Traefik usa HostRegexp.
SERVER_URL=https://tu-dominio.com

# Firma de tokens/sesiones. Rotarlo desloguea a todos los usuarios.
# generar: openssl rand -base64 32
APP_SECRET=

# --- Storage ---
# `local` guarda los archivos en el volumen twenty-storage, montado en
# /app/packages/twenty-server/.local-storage (el default de STORAGE_LOCAL_PATH
# es `.local-storage`, relativo al WORKDIR de la imagen, así que calza solo).
# El valor pasa por @CastToUpperSnakeCase(): `local` -> LOCAL, `s3` -> S_3.
STORAGE_TYPE=local

# Alternativa S3. Si se activa, hay que volver a agregar estas variables al
# `environment:` de server y worker en el docker-compose.yml.
#STORAGE_S3_REGION=auto
#STORAGE_S3_NAME=
#STORAGE_S3_ENDPOINT=
#STORAGE_S3_ACCESS_KEY_ID=
#STORAGE_S3_SECRET_ACCESS_KEY=

# --- Email (SMTP) ---
# Sin esto el driver por defecto es LOGGER: los mails se escriben en el log del
# contenedor y no sale ninguno. Con LOGGER no funcionan ni la verificación de
# cuenta ni las invitaciones a miembros del workspace.
# Twenty solo soporta LOGGER y SMTP (no tiene driver de API de Resend/SES), así
# que con Resend se usa su relay SMTP: usuario literal `resend`, password = API key.
EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASSWORD=
# OJO: el dominio de EMAIL_FROM_ADDRESS tiene que estar verificado en el
# proveedor, y no tiene por qué coincidir con el dominio donde vive la app.
EMAIL_FROM_ADDRESS=noreply@tu-dominio-verificado.com
EMAIL_FROM_NAME=Tu CRM

# --- Branding ---
# Solo afectan el FRONT (login y UI): el server los expone vía client-config.
# El cuerpo de los emails sigue con las plantillas de Twenty — lo único
# brandeable ahí es el remitente, con EMAIL_FROM_NAME / EMAIL_FROM_ADDRESS.
# APP_LOGO_URL tiene que ser una URL pública y absoluta a una imagen.
APP_NAME=Twenty
APP_LOGO_URL=

# --- Multi-workspace ---
IS_MULTIWORKSPACE_ENABLED=true
# true = solo un usuario existente con canAccessFullAdminPanel puede crear
# workspaces (los crea desde su propia sesión). false = signup self-service
# abierto: cualquiera con la URL se registra y arma su workspace.
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false
DEFAULT_SUBDOMAIN=app
MAX_WORKSPACES_LIMIT=100000

# El front deduce la URL de la API del propio host que lo sirvió. Necesario
# acá porque un solo build de imagen atiende N subdominios distintos.
FRONT_AUTO_BASE_URL=true
